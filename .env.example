# Copy to .env (git-ignored) and fill in. Read by docker-compose.yml.
DATABASE_URL=libsql://<db>-<org>.<region>.turso.io
DATABASE_AUTH_TOKEN=
JWT_SECRET=

# Email via Amazon SES SMTP (region must match the SES identity)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@shettigarevents.com
